# Documentation example only: the app does not automatically load .env files.
# Set variables in your terminal (see README). No API key is needed for sample mode.
PROOFKIT_MODE=sample
# Default: data/jobs.sqlite3 beside app.py. Relative paths use the working directory.
PROOFKIT_DB=data/jobs.sqlite3
# Required only with PROOFKIT_MODE=live. Supply your own values privately.
OPENAI_API_KEY=
OPENAI_MODEL=
